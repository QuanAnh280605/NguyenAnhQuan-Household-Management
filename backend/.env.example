# ==============================================================================
# ResidentHub — FastAPI Backend Environment Variables
# ==============================================================================

# Project Information
PROJECT_NAME="ResidentHub API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Connection (PostgreSQL 13+)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/residenthub"

# CORS Origins (Allowed web clients)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Security & Authentication (JWT & HMAC)
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# VietQR Payment Gateway Webhook Secret (HMAC-SHA256)
VIETQR_WEBHOOK_SECRET="replace-with-napas247-webhook-secret"
