{
  "name": "resident-hub-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "pytest backend/tests -v -o cache_dir=backend/.pytest_cache",
    "test:backend": "pytest backend/tests -v -o cache_dir=backend/.pytest_cache"
  }
}
