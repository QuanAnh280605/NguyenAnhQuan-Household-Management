# ==============================================================================
# ResidentHub Monorepo — Environment Variables Guide
# ==============================================================================
# Copy the respective .env.example files to .env in backend/ and frontend/:
#
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env
#
# ------------------------------------------------------------------------------
# Backend Configurations (FastAPI + asyncpg)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/residenthub"
PROJECT_NAME="ResidentHub API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
SECRET_KEY="your-secret-key-here"

# ------------------------------------------------------------------------------
# Frontend Configurations (Next.js 16 + React 19)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_NAME="ResidentHub"
